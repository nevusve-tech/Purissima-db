# ---------------------------------------------------------------------
# Base de datos (obligatorio)
# ---------------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string
# Se recomienda el "Connection pooler" (puerto 6543, modo transaction).
DATABASE_URL=postgresql://postgres.akpnummbmragiquaojrs:TU_CLAVE@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# SSL: Supabase lo exige. Sólo poner false con un PostgreSQL local sin SSL.
PGSSL=true

# ---------------------------------------------------------------------
# Seguridad (obligatorio en producción, mínimo 32 caracteres)
# ---------------------------------------------------------------------
JWT_SECRET=cambie-esto-por-un-secreto-largo-y-aleatorio-de-64-caracteres
TOKEN_TTL_SEC=43200

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Sólo si el frontend se sirve desde otro dominio
# CORS_ORIGIN=https://app.midominio.com

# ---------------------------------------------------------------------
# Correo (opcional). Nodemailer primero; si falla, Resend.
# ---------------------------------------------------------------------
ADMIN_EMAIL=
MAIL_FROM=Purissima Cloud <no-reply@midominio.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
